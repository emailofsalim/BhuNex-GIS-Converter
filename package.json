{
  "name": "universal-bhunex-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Universal GIS / Geomatics / Survey / CAD / Mining conversion suite as a Chrome MV3 extension.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "package": "node scripts/package-extension.mjs",
    "docs": "node --experimental-strip-types scripts/format-matrix.mjs",
    "docs:check": "node --experimental-strip-types scripts/format-matrix.mjs --check",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run build",
    "build:store": "STORE_BUILD=1 vite build",
    "store:check": "node scripts/assert-store-ready.mjs",
    "store:package": "npm run build:store && node scripts/assert-store-ready.mjs && node scripts/package-extension.mjs",
    "assets": "node scripts/make-store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
