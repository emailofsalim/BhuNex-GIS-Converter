node_modules/

# dist/ and dist-zip/ are COMMITTED on purpose, and it is the one exception
# worth making. A browser loads a folder; it cannot build one. Gitignoring the
# build meant that downloading this repository and pointing "Load unpacked" at
# it produced "Manifest file is missing or unreadable" — the obvious use of the
# repository failed. scripts/assert-build-committed.mjs rebuilds from source in
# CI and fails if the committed copy has drifted, so it cannot go stale.
#
# `npm run build` (the developer build, with source maps) writes over dist/ and
# will show as a diff. `npm run build:store` puts it back.

*.log
.DS_Store
.vite/
coverage/

# Screenshots dropped in to report a bug or ask for a change.
#
# They are worth having in the moment and worth nothing afterwards, and they
# are heavy: 44 of them had grown to 18 MB — nearly three quarters of the whole
# repository, against 3.5 MB of actual source. Every person who cloned it, and
# every "Code → Download ZIP" install (which the README offers as a supported
# route), carried all of them.
#
# Ignored rather than merely deleted, so the next batch stays local.
Screenshort_Feedback/
Screenshot*/
screenshots/
