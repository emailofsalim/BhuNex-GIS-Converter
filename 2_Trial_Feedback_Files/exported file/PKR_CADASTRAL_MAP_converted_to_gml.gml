ss Plot Area&lt;/td&gt;&lt;td&gt;1.5958 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Less: Minedout&lt;/td&gt;&lt;td&gt;- 0.0000 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Less: Safety Belt&lt;/td&gt;&lt;td&gt;- 0.0187 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Minedout / Belt Overlap&lt;/td&gt;&lt;td&gt;Nil - zones do not intersect&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Net Mineable Area&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;1.5771 Ha&lt;/b&gt; - 98.8 pct of plot&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;6. Mineral Quantity and Quality&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Overburden OB&lt;/td&gt;&lt;td&gt;16,539.00 m3&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Bauxite In-situ BXT&lt;/td&gt;&lt;td&gt;&lt;b&gt;11,019.00 t&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;70 pct Recovery&lt;/td&gt;&lt;td&gt;&lt;b&gt;7,713.30 t&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Stripping Ratio&lt;/td&gt;&lt;td&gt;1.50 m3 OB per t BXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reserve Intensity&lt;/td&gt;&lt;td&gt;6,905 t per Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Total Available Alumina TAA&lt;/td&gt;&lt;td&gt;&lt;b&gt;35.32 pct&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Silica SiO2&lt;/td&gt;&lt;td&gt;5.23 pct&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Alumina to Silica Ratio&lt;/td&gt;&lt;td&gt;6.75 to 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Grade Classification&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;background:#C5E0B4;color:#1F2937;padding:2px 6px;&quot;&gt;B - Good Grade (TAA 35 to 37 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Polygon Fill Colour&lt;/td&gt;&lt;td&gt;Hex C5E0B4&lt;/td&gt;&lt;/tr&gt