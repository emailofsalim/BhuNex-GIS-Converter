6FF;border-left:3px solid #1D4ED8;padding:6px 10px;font-size:10px;color:#1E3A8A;margin-top:4px;&quot;&gt; Plot spans more than one lease; this polygon is the 109.507 portion.&lt;/div&gt;&lt;div class=&quot;sec-hdr&quot;&gt;2. Area Reconciliation (Deed vs Survey)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Area (Deed, Acres)&lt;/td&gt;&lt;td&gt;0.60 ac&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Area (Deed, Hectares)&lt;/td&gt;&lt;td&gt;0.2428 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Computed Polygon Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3874 Ha&lt;/b&gt; (3,873.6 m2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Variance (Survey - Deed)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;+0.1446 Ha (+59.54 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;3. Land Acquisition Status&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#FEF2F2;&quot;&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B91C1C;&quot;&gt;Not Acquired&lt;/b&gt; - no acquisition entry in deed register&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;4. Safety Belt (7.5 m inward of lease boundary)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#DBEAFE;&quot;&gt;&lt;td&gt;&lt;b&gt;Safety Zone (7.5 m)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.0586 Ha&lt;/b&gt; of 0.3874 Ha - &lt;span style=&quot;background:#1D4ED8;color:#fff;padding:1px 5px;border-radius:3px;&quot;&gt;15.1 pct&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Statutory Basis&lt;/td&gt;&lt;td&gt;MMR 1961 Reg. 106 - no excavation within belt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;5. Minedout Status and Net Mineable Ground&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Minedout Area&lt;/td&gt;&lt;td&gt;Nil - plot not yet worked&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Gross Plot Area&lt;/td&gt;&lt;td&gt;0.3874 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Less: Minedout&lt;/td&gt;&lt;td&gt;- 0.0000 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Less: Safety Belt&lt;/td&gt;&lt;td&gt;- 0.0586 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Minedout / Belt Overlap&lt;/td&gt;&lt;td&gt;Nil - zones do not intersect&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Net Mineable Area&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;0.3288 Ha&lt;/b&gt; - 84.9 pct of plot&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;6. Mineral Quantity and Quality&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#F3F4F6;&quot;&gt;&lt;td&gt;Mineral Data&lt;/td&gt;&lt;td&gt;&lt;i&gt;Not Applicable - the mineral map covers the 115.13 Ha lease only.&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;7. RS Khatiyan / Hal Sarve Cross-Reference&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;RS Khata&lt;/td&gt;&lt;td&gt;99&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;RS Plot&lt;/td&gt;&lt;td&gt;748(P)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RS Area (Ac)&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;RS Class&lt;/td&gt;&lt;td&gt;Tanr II&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;8. Survey and Geodetic Metadata&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Centroid (Lat, Long)&lt;/td&gt;&lt;td&gt;23.55784903 N, 84.61905246 E&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Centroid (UTM 45N)&lt;/td&gt;&lt;td&gt;E 256,963.14 m, N 2,607,294.72 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Horizontal Datum&lt;/td&gt;&lt;td&gt;WGS 84 (EPSG:4326)&lt;/td&gt;&lt;/tr