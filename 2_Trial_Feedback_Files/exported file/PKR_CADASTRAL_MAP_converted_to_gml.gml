<gml:featureMember><ugc:feature gml:id="18"><ugc:name>2127</ugc:name><ugc:description>&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;width:460px;color:#1F2937;&quot;&gt;&lt;style&gt;.tbl { width:100%; border-collapse:collapse; font-size:11px; }.tbl td { padding:5px 8px; border-bottom:1px solid #E5E7EB; }.tbl td:first-child { font-weight:600; color:#4B5563; width:44%; }.sec-hdr { background:#F3F4F6; padding:6px 10px; font-weight:700; color:#111827; border-top:2px solid #0B5394; margin-top:6px; font-size:11px; }&lt;/style&gt;&lt;div style=&quot;background:#0B5394;color:#fff;padding:8px 12px;border-radius:4px 4px 0 0;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;&quot;&gt;Plot 2127&lt;span style=&quot;float:right;font-size:10px;background:#2F5597;color:#FFFFFF;padding:3px 8px;border-radius:10px;font-weight:700;&quot;&gt;GRADE A&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Pakhar 115.13 Ha - Pakhar, Kisko (Th.No.104), Lohardaga, Jharkhand&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;sec-hdr&quot;&gt;1. Land Deed / Identification&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Village&lt;/td&gt;&lt;td&gt;Pakhar&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Thana / Thana No&lt;/td&gt;&lt;td&gt;Kisko / 104&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;District, State&lt;/td&gt;&lt;td&gt;Lohardaga, Jharkhand&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Khata No&lt;/td&gt;&lt;td&gt;&lt;b&gt;165&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Plot No&lt;/td&gt;&lt;td&gt;&lt;b&gt;2127&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Block&lt;/td&gt;&lt;td&gt;A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Part / Whole&lt;/td&gt;&lt;td&gt;Part&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Land Class&lt;/td&gt;&lt;td&gt;Tanr II&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Owner Name&lt;/td&gt;&lt;td&gt;&lt;i&gt;Not recorded in deed schedule&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;2. Area Reconciliation (Deed vs Survey)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Area (Deed, Acres)&lt;/td&gt;&lt;td&gt;2.75 ac&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Area (Deed, Hectares)&lt;/td&gt;&lt;td&gt;1.1129 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Computed Polygon Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.7537 Ha&lt;/b&gt; (7,536.6 m2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Variance (Survey - Deed)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;-0.3592 Ha (-32.28 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;3. Land Acquisition Status&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#DCFCE7;&quot;&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;Acquired&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Acquired Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;2.75 ac&lt;/b&gt; (1.1129 Ha)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Balance To Acquire&lt;/td&gt;&lt;td&gt;0.00 ac (0.0000 Ha)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Acquisition Progress&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#15803D;color:#fff;padding:1px 5px;border-radius:3px;&quot;&gt;100.0 pct&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Purchase Deed / Date&lt;/td&gt;&lt;td&gt;19.10.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Issues / Encumbrance&lt;/td&gt;&lt;td&gt;None recorded&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;4. Safety Belt (7.5 m inward of lease boundary)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#DBEAFE;&quot;&gt;&lt;td&gt;&lt;b&gt;Safety Zone (7.5 m