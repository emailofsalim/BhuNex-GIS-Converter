<gml:featureMember><ugc:feature gml:id="3"><ugc:name>894</ugc:name><ugc:description>&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;width:460px;color:#1F2937;&quot;&gt;&lt;style&gt;.tbl { width:100%; border-collapse:collapse; font-size:11px; }.tbl td { padding:5px 8px; border-bottom:1px solid #E5E7EB; }.tbl td:first-child { font-weight:600; color:#4B5563; width:44%; }.sec-hdr { background:#F3F4F6; padding:6px 10px; font-weight:700; color:#111827; border-top:2px solid #0B5394; margin-top:6px; font-size:11px; }&lt;/style&gt;&lt;div style=&quot;background:#0B5394;color:#fff;padding:8px 12px;border-radius:4px 4px 0 0;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;&quot;&gt;Plot 894&lt;span style=&quot;float:right;font-size:10px;background:#C5E0B4;color:#1F2937;padding:3px 8px;border-radius:10px;font-weight:700;&quot;&gt;GRADE B&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Pakhar 115.13 Ha - Pakhar, Kisko (Th.No.104), Lohardaga, Jharkhand&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;sec-hdr&quot;&gt;1. Land Deed / Identification&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Village&lt;/td&gt;&lt;td&gt;Pakhar&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Thana / Thana No&lt;/td&gt;&lt;td&gt;Kisko / 104&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;District, State&lt;/td&gt;&lt;td&gt;Lohardaga, Jharkhand&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Khata No&lt;/td&gt;&lt;td&gt;&lt;b&gt;25&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Plot No&lt;/td&gt;&lt;td&gt;&lt;b&gt;894&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Block&lt;/td&gt;&lt;td&gt;A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Part / Whole&lt;/td&gt;&lt;td&gt;Part&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Land Class&lt;/td&gt;&lt;td&gt;Tanr II&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Owner Name&lt;/td&gt;&lt;td&gt;&lt;i&gt;Not recorded in deed schedule&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;2. Area Reconciliation (Deed vs Survey)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Area (Deed, Acres)&lt;/td&gt;&lt;td&gt;0.68 ac&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Area (Deed, Hectares)&lt;/td&gt;&lt;td&gt;0.2752 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Computed Polygon Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.4871 Ha&lt;/b&gt; (4,870.6 m2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Variance (Survey - Deed)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;+0.2119 Ha (+76.98 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;3. Land Acquisition Status&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#FEF2F2;&quot;&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B91C1C;&quot;&gt;Not Acquired&lt;/b&gt; - no acquisition entry in deed register&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;4. Safety Belt (7.5 m inward of lease boundary)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#DBEAFE;&quot;&gt;&lt;td&gt;&lt;b&gt;Safety Zone (7.5 m)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.0644 Ha&lt;/b&gt; of 0.4871 Ha - &lt;span style=&quot;background:#1D4ED8;color:#fff;padding:1px 5px;border-radius:3px;&quot;&gt;13.2 pct&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Statutory Basis&lt;/td&gt;&lt;td&gt;MMR 1961 Reg. 106 - no excavation within belt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;5. Minedout Status and Net Mineable Ground&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Minedout Area&lt;/td&gt;&lt;td&gt;Nil - plot not yet worked&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Gross Plot Area&lt;/td&gt;&lt;td&gt;0.4871 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Less: Minedout&lt;/td&gt;&lt;td&gt;- 0.0000 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Less: Safety Belt&lt;/td&gt;&lt;td&gt;- 0.0644 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Minedout / Belt Overlap&lt;/td&gt;&lt;td&gt;Nil - zones do not intersect&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Net Mineable Area&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;0.4226 Ha&lt;/b&gt; - 86.8 pct of plot&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;6. Mineral Quantity and Quality&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Overburden OB&lt;/td&gt;&lt;td&gt;37,799.00 m3&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Bauxite In-situ BXT&lt;/td&gt;&lt;td&gt;&lt;b&gt;81,685.00 t&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;70 pct Recovery&lt;/td&gt;&lt;td&gt;&lt;b&gt;57,179.50 t&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Stripping Ratio&lt;/td&gt;&lt;td&gt;0.46 m3 OB per t BXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reserve Intensity&lt;/td&gt;&lt;td&gt;167,710 t per Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Total Available Alumina TAA&lt;/td&gt;&lt;td&gt;&lt;b&gt;36.79 pct&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Silica SiO2&lt;/td&gt;&lt;td&gt;2.30 pct&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Alumina to Silica Ratio&lt;/td&gt;&lt;td&gt;16.00 to 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Grade Classification&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;background:#C5E0B4;color:#1F2937;padding:2px 6px;&quot;&gt;B - Good Grade (TAA 35 to 37 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Polygon Fill Colour&lt;/td&gt;&lt;td&gt;Hex C5E0B4&lt;/td&gt;&lt;/