ner Name&lt;/td&gt;&lt;td&gt;&lt;i&gt;Not recorded in deed schedule&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;background:#EFF6FF;border-left:3px solid #1D4ED8;padding:6px 10px;font-size:10px;color:#1E3A8A;margin-top:4px;&quot;&gt; Plot spans more than one lease; this polygon is the 115.13 portion.&lt;/div&gt;&lt;div class=&quot;sec-hdr&quot;&gt;2. Area Reconciliation (Deed vs Survey)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Area (Deed, Acres)&lt;/td&gt;&lt;td&gt;0.37 ac&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Area (Deed, Hectares)&lt;/td&gt;&lt;td&gt;0.1497 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Computed Polygon Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.1881 Ha&lt;/b&gt; (1,881.4 m2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Variance (Survey - Deed)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;+0.0384 Ha (+25.68 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;3. Land Acquisition Status&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#DCFCE7;&quot;&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;Acquired&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Acquired Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.37 ac&lt;/b&gt; (0.1497 Ha)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Balance To Acquire&lt;/td&gt;&lt;td&gt;0.00 ac (0.0000 Ha)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Acquisition Progress&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#15803D;color:#fff;padding:1px 5px;border-radius:3px;&quot;&gt;100.0 pct&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Purchase Deed / Date&lt;/td&gt;&lt;td&gt;29.10.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Issues / Encumbrance&lt;/td&gt;&lt;td&gt;None recorded&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt