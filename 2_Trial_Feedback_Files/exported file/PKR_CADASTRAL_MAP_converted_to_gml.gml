<gml:featureMember><ugc:feature gml:id="123"><ugc:name>798</ugc:name><ugc:description>&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;width:460px;color:#1F2937;&quot;&gt;&lt;style&gt;.tbl { width:100%; border-collapse:collapse; font-size:11px; }.tbl td { padding:5px 8px; border-bottom:1px solid #E5E7EB; }.tbl td:first-child { font-weight:600; color:#4B5563; width:44%; }.sec-hdr { background:#F3F4F6; padding:6px 10px; font-weight:700; color:#111827; border-top:2px solid #EA580C; margin-top:6px; font-size:11px; }&lt;/style&gt;&lt;div style=&quot;background:#EA580C;color:#fff;padding:8px 12px;border-radius:4px 4px 0 0;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;&quot;&gt;Plot 798&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Pakhar 109.507 Ha - Pakhar, Kisko (Th.No.104), Lohardaga, Jharkhand&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;sec-hdr&quot;&gt;1. Land Deed / Identification&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Village&lt;/td&gt;&lt;td&gt;Pakhar&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Thana / Thana No&lt;/td&gt;&lt;td&gt;Kisko / 104&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;District, State&lt;/td&gt;&lt;td&gt;Lohardaga, Jharkhand&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Khata No&lt;/td&gt;&lt;td&gt;&lt;b&gt;58&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Plot No&lt;/td&gt;&lt;td&gt;&lt;b&gt;798&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Part / Whole&lt;/td&gt;&lt;td&gt;Whole&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Land Class&lt;/td&gt;&lt;td&gt;Tanr II&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Owner Name&lt;/td&gt;&lt;td&gt;&lt;b&gt;Jagat Asur&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ownership&lt;/td&gt;&lt;td&gt;&lt;b&gt;Raiyati&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;2. Area Reconciliation (Deed vs Survey)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;Area (Deed, Acres)&lt;/td&gt;&lt;td&gt;1.59 ac&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Area (Deed, Hectares)&lt;/td&gt;&lt;td&gt;0.6435 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Computed Polygon Area&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.6537 Ha&lt;/b&gt; (6,536.9 m2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Variance (Survey - Deed)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#15803D;&quot;&gt;+0.0102 Ha (+1.58 pct)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;3. Land Acquisition Status&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#FEF2F2;&quot;&gt;&lt;td&gt;&lt;b&gt;Status&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#B91C1C;&quot;&gt;Not Acquired&lt;/b&gt; - no acquisition entry in deed register&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;4. Safety Belt (7.5 m inward of lease boundary)&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr style=&quot;background:#F0FDF4;&quot;&gt;&lt;td&gt;Safety Zone (7.5 m)&lt;/td&gt;&lt;td&gt;Nil - plot lies wholly outside the safety belt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div class=&quot;sec-hdr&quot;&gt;5. Minedout Status and Net Mineable Ground&lt;/div&gt;&lt;table class=&quot;tbl&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b style=&quot;color:#B45309;&quot;&gt;Minedout Area&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.0180 Ha&lt;/b&gt; of 0.6537 Ha - &lt;span style=&quot;background:#F59E0B;color:#fff;padding:1px 5px;border-radius:3px;&quot;&gt;2.8 pct&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&lt;td&gt;Un-mined (virgin) Area&lt;/td&gt;&lt;td&gt;0.6356 Ha - 97.2 pct&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gross Plot Area&lt;/td&gt;&lt;td&gt;0.6537 Ha&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F9FAFB;&quot;&gt;&