{
  "manifest_version": 3,
  "name": "Universal BhuNex Converter \u2014 GIS/CAD/Survey",
  "short_name": "BhuNex",
  "version": "1.1.0",
  "description": "Convert GIS, survey, CAD, LiDAR and mining data offline. Nothing is uploaded \u2014 every file is processed on your machine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Universal BhuNex Converter",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/workspace/index.html",
  "commands": {
    "open-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open the Universal BhuNex Converter workspace"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' blob: data:"
  },
  "web_accessible_resources": [],
  "offline_enabled": true
}
